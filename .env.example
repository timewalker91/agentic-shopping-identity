# Copy to .env (gitignored). Values here are ids, never secrets.
# AWS credentials come from the environment: `source ~/.aws_workshop_env` before starting anything.

# local = no AWS at all (in-memory tables, local signing key, local demo user)
# aws   = DynamoDB + KMS + Cognito, using the ids that infra/setup.py prints
AGENTPASS_MODE=local
AWS_REGION=us-east-1

# aws mode: printed by `python -m infra.setup`
AGENTPASS_KMS_KEY_ID=
AGENTPASS_AGENT_KMS_KEY_ID=   # the agent's own identity key (ECC P-256); the broker signs its assertions with it
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# local mode: the agent's key file (created on first use, gitignored)
AGENTPASS_AGENT_KEY_FILE=.local/agent_shopper_v1.pem

# local mode demo users, "user:password" pairs separated by commas
AGENTPASS_LOCAL_USERS=parent:parent-pass

# Demo mandate created at first login: budget in dollars, merchant, locked shipping address
AGENTPASS_DEMO_BUDGET=50
AGENTPASS_DEMO_MERCHANT=freshmart
AGENTPASS_DEMO_SHIP_TO=addr_home

# Store MCP server (only the gateway talks to it)
AGENTPASS_STORE_URL=http://127.0.0.1:8100/mcp
STORE_BACKEND=mock            # mock | shopify
SHOPIFY_STORE_DOMAIN=         # e.g. agentpass-dev.myshopify.com (UCP MCP endpoint: https://<domain>/api/ucp/mcp)
UCP_AGENT_PROFILE_URL=        # public HTTPS URL of your UCP agent profile; default = Shopify's test fixture
SHOPIFY_COUNTRY=US
PAYMENT_MOCK_FUNDS=150        # dollars available in the payment mock before it answers insufficient_funds
STORE_CHECKOUT=mock           # mock = payment mock | shopify = real Shopify checkout, parent pays at continue_url (needs STORE_BACKEND=shopify)
SHOPIFY_ADDRESS_BOOK=         # ship_to_id -> contact + address JSON; default store/address_book.json, else the .example file

# Agent
AGENTPASS_API_URL=http://127.0.0.1:8000
AGENT_DRIVER=scripted         # scripted | bedrock
# Search words the scripted scenarios use (defaults fit the mock catalog; change them for a real store)
AGENT_QUERY_HAPPY=            # S1/S6, default "school supplies"
AGENT_QUERY_EXPENSIVE=        # S2 over-budget item, default "headphones"
AGENT_QUERY_CHEAP=            # S2 fallback item, default "notebook"
AGENT_QUERY_POISONED=         # S3 listing with the hidden instruction, default "markers"
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5   # the workshop allowlist blocks the 5.5 models; Llama 4: us.meta.llama4-scout-17b-instruct-v1:0
