# Copy to .env (gitignored). Values here are ids, never secrets.
# AWS credentials come from the environment: `source ~/.aws_workshop_env` before starting anything.

# local = no AWS at all (in-memory tables, local signing key, local demo user)
# aws   = DynamoDB + KMS + Cognito, using the ids that infra/setup.py prints
AGENTPASS_MODE=local
AWS_REGION=us-east-1

# AWS credentials (Bedrock driver; aws mode). Paste your keys; empty lines are ignored.
# Session tokens expire: refresh all three together. Values exported in the shell win over these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Local demo login for `agent login` (skips the username/password prompt)
AGENT_USER=parent
AGENT_PASSWORD=parent-pass

# aws mode: printed by `python -m infra.setup`
AGENTPASS_KMS_KEY_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# local mode demo users, "user:password" pairs separated by commas
AGENTPASS_LOCAL_USERS=parent:parent-pass

# Demo mandate created at first login: budget in dollars, merchant, locked shipping address
AGENTPASS_DEMO_BUDGET=50000
AGENTPASS_DEMO_MERCHANT=MyTestStore
AGENTPASS_DEMO_SHIP_TO=addr_home

# Store MCP server (only the gateway talks to it)
AGENTPASS_STORE_URL=http://127.0.0.1:8100/mcp
STORE_MERCHANT=MyTestStore       # must equal AGENTPASS_DEMO_MERCHANT, or add_to_cart is denied
STORE_BACKEND=shopify            # mock | shopify
SHOPIFY_STORE_DOMAIN=test-store-lrcsunt5.myshopify.com         # e.g. agentpass-dev.myshopify.com (UCP MCP endpoint: https://<domain>/api/ucp/mcp)
UCP_AGENT_PROFILE_URL=        # public HTTPS URL of your UCP agent profile; default = Shopify's test fixture
SHOPIFY_COUNTRY=US
PAYMENT_MOCK_FUNDS=1000000        # dollars available in the payment mock before it answers insufficient_funds
STORE_CHECKOUT=shopify            # real Shopify checkout; the parent pays at continue_url (Bogus gateway on the dev store)

# Agent
AGENTPASS_API_URL=http://127.0.0.1:8000
AGENT_DRIVER=scripted         # scripted | bedrock
BEDROCK_MODEL_ID=us.meta.llama4-scout-17b-instruct-v1:0   # cross-region inference profile (bare id has no on-demand throughput)

# Scripted scenario search words, pointed at the Shopify store's snowboard catalog
AGENT_QUERY_HAPPY=snowboard
AGENT_QUERY_EXPENSIVE=snowboard
AGENT_QUERY_CHEAP=snowboard
AGENT_QUERY_POISONED=snowboard
